# Archify environment configuration
#
# Copy this file to `.env.local` and fill in your key:
#     cp .env.example .env.local
#
# `.env.local` is git-ignored, so your key is never committed.
# Vite only exposes variables prefixed with VITE_ to the browser.
# NOTE: this is a client-side app, so any key here is shipped to the
# browser. Use a personal/dev key, not a production secret.

# Which provider to use by default: "openai" or "anthropic"
VITE_LLM_PROVIDER=openai

# --- OpenAI ---
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (optional) ---
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-sonnet-5
